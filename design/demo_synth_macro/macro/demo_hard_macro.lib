/* Timing view of demo_hard_macro. Pairs with demo_hard_macro.lef: the LEF gives
 * the block its extent, this gives it its arcs. Between them OpenROAD has a
 * complete master, which is why the RTL blackbox must NOT also be handed to it
 * as Verilog -- see synth/demo_synth_macro/README.md.
 *
 * area is 8000, chosen to dwarf the handful of standard cells around it so that
 * an area figure which omits the macro is obvious rather than merely wrong.
 *
 * `scalar` is a built-in zero-dimensional template. Declaring it here with an
 * axis of its own is what makes OpenSTA reject the constraint tables below
 * ("unsupported model axis", then CRITICAL STA-0242). Nangate45's own Liberty
 * uses (scalar) 438 times and never declares it either.
 */
library (demo_hard_macro_lib) {
  delay_model               : table_lookup;
  time_unit                 : "1ns";
  voltage_unit              : "1V";
  current_unit              : "1mA";
  pulling_resistance_unit   : "1kohm";
  leakage_power_unit        : "1nW";
  capacitive_load_unit (1, pf);

  nom_process               : 1.0;
  nom_temperature           : 25.0;
  nom_voltage               : 1.1;

  default_cell_leakage_power : 0.0;
  default_fanout_load        : 1.0;
  default_max_transition     : 1.0;

  type (bus8) {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from  : 7;
    bit_to    : 0;
    downto    : true;
  }

  cell (demo_hard_macro) {
    area          : 8000.0;
    dont_use      : true;
    dont_touch    : true;
    is_macro_cell : true;

    pin (clk) {
      direction   : input;
      capacitance : 0.05;
      clock       : true;
      min_pulse_width_high : 0.5;
      min_pulse_width_low  : 0.5;
    }
    pin (en) {
      direction   : input;
      capacitance : 0.01;
      timing () {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.15"); }
        fall_constraint (scalar) { values ("0.15"); }
      }
      timing () {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint (scalar) { values ("0.05"); }
        fall_constraint (scalar) { values ("0.05"); }
      }
    }
    bus (d) {
      bus_type    : bus8;
      direction   : input;
      capacitance : 0.01;
      timing () {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.15"); }
        fall_constraint (scalar) { values ("0.15"); }
      }
      timing () {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint (scalar) { values ("0.05"); }
        fall_constraint (scalar) { values ("0.05"); }
      }
    }
    bus (q) {
      bus_type        : bus8;
      direction       : output;
      max_capacitance : 0.2;
      timing () {
        related_pin  : "clk";
        timing_type  : rising_edge;
        timing_sense : non_unate;
        cell_rise  (scalar) { values ("0.80"); }
        cell_fall  (scalar) { values ("0.80"); }
        rise_transition (scalar) { values ("0.10"); }
        fall_transition (scalar) { values ("0.10"); }
      }
    }
  }
}
